@import "tailwindcss";

/* =========================================================================
   Trackr design tokens — one source of truth for colour, type, radius, depth.
   Semantic names flip value in dark mode, so a component references the
   *meaning*, never a raw colour, and themes itself.
   (Brand values here are the pre-JS fallback; ThemeService writes the live
   accent onto <html> at runtime.)
   ========================================================================= */

/* Light theme — the default. */
:root {
  color-scheme: light;

  --bg: #FBFAF8;
  --surface: #FFFFFF;
  --surface-2: #F6F2EF;
  --line: #ECE5E0;
  --ink: #221E1C;
  --muted: #8A817B;
  --faint: #B7ADA6;

  --brand: #4F46E5;
  --brand-ink: #4338CA;
  --brand-soft: #EEF2FF;

  --leaf: #2AA96A;
  --leaf-soft: #E4F5EC;

  --amber: #DB9327;
  --amber-soft: #F9EDD6;

  --danger: #E11D48;
  --danger-ink: #BE123C;
  --danger-soft: #FFE4E6;
}

/* Dark theme via OS setting (unless the user explicitly chose light). */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;

    --bg: #16120E;
    --surface: #201B16;
    --surface-2: #2A231C;
    --line: #342C24;
    --ink: #F4EEE8;
    --muted: #A79D94;
    --faint: #7B7168;

    --brand: #6366F1;
    --brand-ink: #A5B4FC;
    --brand-soft: #24224A;

    --leaf: #3EC182;
    --leaf-soft: #173026;

    --amber: #E9A93F;
    --amber-soft: #2E2413;

    --danger: #FB7185;
    --danger-ink: #FDA4AF;
    --danger-soft: #3A1720;
  }
}

/* Dark theme when the user explicitly picks it (wins over the OS setting). */
:root[data-theme="dark"] {
  color-scheme: dark;

  --bg: #16120E;
  --surface: #201B16;
  --surface-2: #2A231C;
  --line: #342C24;
  --ink: #F4EEE8;
  --muted: #A79D94;
  --faint: #7B7168;

  --brand: #6366F1;
  --brand-ink: #A5B4FC;
  --brand-soft: #24224A;

  --leaf: #3EC182;
  --leaf-soft: #173026;

  --amber: #E9A93F;
  --amber-soft: #2E2413;

  --danger: #FB7185;
  --danger-ink: #FDA4AF;
  --danger-soft: #3A1720;
}

/* Expose tokens to Tailwind so bg-surface, text-ink, text-leaf, text-danger… work. */
@theme inline {
  --color-bg: var(--bg);
  --color-surface: var(--surface);
  --color-surface2: var(--surface-2);
  --color-line: var(--line);
  --color-ink: var(--ink);
  --color-muted: var(--muted);
  --color-faint: var(--faint);

  --color-brand: var(--brand);
  --color-brand-ink: var(--brand-ink);
  --color-brand-soft: var(--brand-soft);

  --color-leaf: var(--leaf);
  --color-leaf-soft: var(--leaf-soft);

  --color-amber: var(--amber);
  --color-amber-soft: var(--amber-soft);

  --color-danger: var(--danger);
  --color-danger-ink: var(--danger-ink);
  --color-danger-soft: var(--danger-soft);

  --font-sans: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Bricolage Grotesque", ui-sans-serif, sans-serif;

  --radius-xl: 14px;
  --radius-2xl: 20px;
  --radius-3xl: 26px;

  --shadow-card: 0 1px 2px rgba(34, 30, 28, 0.04), 0 10px 26px -14px rgba(34, 30, 28, 0.14);
  --shadow-pop: 0 16px 40px -12px rgba(34, 30, 28, 0.22);
}

body {
  background-color: var(--bg);
  color: var(--ink);
}

input::-ms-reveal,
input::-ms-clear {
  display: none;
}